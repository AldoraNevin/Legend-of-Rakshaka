theme_override_styles/focus = SubResource("card_StyleBoxTexture_2xpgi")
toggle_mode = true
script = ExtResource("card_1")
entity_id = "jimat_kalimasada"
category = "Buff"
description = "pusaka paling keramat dalam dunia pewayangan Jawa yang menjadi jimat andalan Prabu Puntadewa (Yudistira), sulung dari lima ksatria Pandawa penguasa Kerajaan Amarta.

EFEK
Maksimum HP +25, damage +25%, kecepatan +20%."
history = "Berbeda dengan pusaka lainnya yang berwujud senjata tajam atau pemukul, artefak ini berwujud sebuah kitab suci berisi ajaran kebenaran mutlak, kebijaksanaan, dan jalan keselamatan sejati yang dalam tradisi dakwah Wali Songo dimaknai sebagai perlambang Kalimat Syahadat. Dalam kisah pewayangan, Jimat Kalimasada hanya dapat dibaca dan dikuasai oleh pemilik hati yang suci tanpa noda kebencian seperti Puntadewa. Konon, kekuatan spiritual kitab ini sanggup menangkis segala bentuk sihir hitam, menundukkan amarah raksasa sekalipun, dan menjadi tameng tak tertembus yang menjamin keselamatan seluruh keluarga Pandawa dari kehancuran. Sebagai artefak, Jimat Kalimasada memancarkan cahaya pelindung suci yang meniadakan kutukan dan membalikkan niat jahat lawan, menjadikannya pusaka pertahanan dan kebijaksanaan tertinggi di atas segala senjata perang."

