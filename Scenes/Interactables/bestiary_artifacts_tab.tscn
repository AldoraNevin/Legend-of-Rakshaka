toggle_mode = true
script = ExtResource("card_1")
entity_id = "pecut_samandiman"
category = "AoE"
description = "Cambuk kilat peninggalan Prabu Klono Sewandono saat menaklukkan Singo Barong. Serangannya menghasilkan gelombang kejut yang mengenai banyak musuh sekaligus di area depan.

EFEK
Setiap ayunan menghasilkan gelombang di depan sejauh 120 px."
history = "Dalam legenda tanah Jawa, pecut sepanjang beberapa meter ini bukanlah cambuk biasa, melainkan pusaka bertuah tinggi yang diperoleh sang raja setelah menjalani laku tapa brata yang berat. Konon, setiap lecutannya mampu membelah gunung, meratakan hutan belantara, hingga menghasilkan dentuman petir yang merontokkan nyali pasukan musuh dari kejauhan. Pusaka ini menjadi penentu kemenangan Prabu Klono Sewandono saat menaklukkan Singo Barong raja berwujud manusia berkepala harimau yang mahkotanya dihinggapi burung merak dalam perjalanan meminang Dewi Songgolangit dari Kerajaan Kediri. Sebagai artefak, Pecut Samandiman menyimpan kekuatan pengendali badai dan wibawa penakluk monster, menjadikannya senjata jarak menengah yang mematikan sekaligus simbol supremasi mutlak seorang raja ksatria."

