toggle_mode = true
script = ExtResource("card_1")
entity_id = "zirah_antakusuma"
category = "Buff"
description = "Baju zirah pusaka kahyangan berwujud rompi berlapis rajah emas yang menjadi pelindung ikonik Raden Gatotkaca, ksatria klan Pandawa berjuluk \"Otot Kawat Tulang Besi\" dalam kisah pewayangan Jawa.

EFEK
Damage masuk -25%; proyektil -50%."
history = "Dalam mitologi pewayangan, zirah sakti ini ditempa dari kulit dan cahaya para dewa di Kahyangan Jonggring Saloka, lalu dianugerahkan oleh Batara Guru kepada Gatotkaca setelah ia berhasil menumpas pemberontakan raksasa Patih Sekipu. Kekuatan utama Kotang Antakusuma terletak pada kemampuannya membuat sang pemakai terbang melesat menembus awan secepat kilat tanpa memerlukan sayap, sekaligus memberikan perlindungan mutlak yang kebal terhadap segala jenis senjata fana maupun hawa dingin langit tertinggi. Sebagai artefak, Zirah Antakusuma memancarkan aura langit yang menyatukan ketahanan fisik tak tertembus dengan kelincahan udara mutlak, menjadikannya perlengkapan tempur legendaris bagi ksatria penguasa angkasa"

