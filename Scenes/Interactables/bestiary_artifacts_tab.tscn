toggle_mode = true
script = ExtResource("card_1")
entity_id = "keris_mpu_gandring"
category = "Offensive"
description = "Keris terkutuk penuh darah. Memberikan status Bleed pada musuh.

EFEK
Bleed: 1 damage/detik selama 3 detik; serangan berikutnya menyegarkan durasi."
history = "Keris ini ditempa oleh seorang pandai besi sakti bernama Mpu Gandring atas pesanan Ken Arok, yang berambisi merebut kekuasaan Tumapel dari tangan Tunggul Ametung. Karena tidak sabar menunggu proses penempaan yang seharusnya memakan waktu satu tahun, Ken Arok merampas keris tersebut sebelum selesai disempurnakan dan langsung menikam Mpu Gandring hingga tewas. Sebelum mengembuskan napas terakhir, Mpu Gandring mengutuk keris itu akan merenggut nyawa tujuh keturunan, termasuk Ken Arok sendiri. Kutukan berdarah tersebut terbukti memicu rangkaian tragedi pembunuhan berantai di lingkungan istana Singasari—menewaskan Tunggul Ametung, Kebo Ijo, Ken Arok, hingga Anusapati—dan menjadikan keris ini simbol ambisi kekuasaan yang berujung petaka"

