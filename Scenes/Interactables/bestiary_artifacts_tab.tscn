script = ExtResource("card_1")
entity_id = "gadha_rujakpolo"
category = "Offensive"
description = "Gada masif milik Bima. Menambah damage fisik secara drastis, namun sedikit mengurangi (Movement Speed) pemain.

EFEK
Damage fisik +75%; kecepatan gerak -10%."
history = "Gada ini awalnya merupakan pusaka milik Prabu Duryudana (raja Kurawa) atau diperoleh Bima dari pemberian gurunya, Resi Drona, maupun anugerah dewa sebagai simbol kekuatan fisik yang luar biasa. Nama \"Rujak Polo\" sendiri secara harfiah bermakna \"penghancur kepala\" (polo dalam bahasa Jawa berarti kepala/otak), yang menggambarkan dahsyatnya daya hancur senjata ini saat diayunkan di medan perang. Dalam puncak kisah perang Baratayudha, Gada Rujak Polo menjadi senjata penentu kemenangan Pandawa saat digunakan Bima untuk mengalahkan Duryudana di tepi telaga Samantapancaka, sekaligus menuntaskan sumpah suci Bima demi menegakkan keadilan."

