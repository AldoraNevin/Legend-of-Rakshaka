[node name="Entry_kujang_pusaka" type="Button" parent="Book/EntryGrid" unique_id=676345257]
custom_minimum_size = Vector2(100, 104)
layout_mode = 2
tooltip_text = "Leak"
accessibility_name = "Leak"
theme_override_styles/normal = SubResource("card_StyleBoxTexture_c6nwo")
theme_override_styles/pressed = SubResource("card_StyleBoxTexture_2xpgi")
