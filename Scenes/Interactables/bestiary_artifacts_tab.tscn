toggle_mode = true
script = ExtResource("card_1")
entity_id = "tombak_baru_klinting"
category = "Offensive"
description = "Tombak pusaka dari lidah naga. Memperpanjang jangkauan (reach) area serangan melee.

EFEK
Jangkauan tebasan +50%."
history = "Dalam legenda tanah Jawa, ketika Baru Klinting bertapa melingkari lereng gunung dalam wujud naga demi diakui sebagai putra ayahnya, lidahnya dipotong oleh Ki Ageng Mangir atas titah sang ayah dan seketika berubah menjadi mata tombak berdaya magis tinggi. Pusaka ini kemudian diwariskan secara turun-temurun hingga jatuh ke tangan Ki Ageng Mangir Wanabaya III, yang menggunakannya untuk mempertahankan kemerdekaan wilayah Perdikan Mangir dari penaklukan Kerajaan Mataram Islam di bawah Panembahan Senopati. Sebagai artefak, Tombak Baru Klinting memancarkan aura mistis darah naga yang mampu menembus pertahanan terkuat dan menundukkan kesaktian musuh, menjadikannya pusaka penentu nasib yang memadukan pengorbanan darah dan harga diri seorang ksatria."

