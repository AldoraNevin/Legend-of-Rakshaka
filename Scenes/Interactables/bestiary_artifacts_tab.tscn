toggle_mode = true
script = ExtResource("card_1")
entity_id = "kujang_pusaka"
category = "Offensive"
description = "Senjata kebesaran tanah Sunda. Memiliki kemampuan Reflect (memantulkan sebagian damage kembali ke musuh saat terkena serangan).

EFEK
Memantulkan 30% damage yang diterima kepada penyerang."
history = "Menurut legenda Tatar Sunda, pusaka ini ditempa oleh Mpu Windu Sarpo atas wangsit gaib untuk Prabu Siliwangi (Sri Baduga Maharaja), bukan sekadar sebagai alat tempur melainkan sebagai jimat penjaga kewibawaan serta keseimbangan alam semesta (Tri Tangtu). Konon, setiap lubang pada bilahnya menyimpan energi spiritual leluhur yang mampu menangkis serangan ilmu hitam, membelah pertahanan musuh dalam gerakan cepat, sekaligus menundukkan roh-roh pengganggu. Sebagai artefak, Kujang Pusaka memancarkan wibawa sang raja agung Pajajaran menjadikannya simbol kebijaksanaan, kesaktian alam, dan pelindung tanah Pasundan yang tak tertembus marabahaya."

