entity_id = "cindaku"
region = "Kerinci, Sumatera"
category = "Melee"
description = "Siluman manusia harimau pelindung hutan dari Sumatera. Musuh yang sangat lincah, mampu melompat jauh ke arah pemain dan memberikan tebasan cakar yang cepat."
history = "Cindaku adalah legenda manusia harimau (therianthrope) yang dipercaya memiliki ikatan batin dan garis keturunan dengan harimau Sumatera. Berbeda dengan monster jahat, Cindaku sebenarnya adalah penjaga keseimbangan alam dan hutan Kerinci. Ia hanya akan berubah wujud menjadi harimau dan marah jika ada manusia yang serakah, merusak hutan, atau melanggar adat setempat."
hp = 5
attack = 2

