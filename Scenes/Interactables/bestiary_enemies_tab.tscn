script = ExtResource("card_1")
entity_id = "jerangkong"
region = "Jawa"
category = "Melee"
description = "Tulang belulang manusia kutukan yang bergerak secara gaib. Musuh rapuh namun memiliki mekanik Revive: jika tulangnya tidak segera dihancurkan sepenuhnya setelah tumbang, ia bisa menyatu dan bangkit kembali."
history = "Jerangkong berarti kerangka atau tulang-belulang manusia. Dalam cerita rakyat Jawa, Jerangkong adalah arwah penasaran yang bangkit dalam wujud tengkorak hidup karena semasa hidupnya menyimpan urusan duniawi yang belum tuntas, atau terkena kutukan. Sosoknya sering dikaitkan dengan pesan moral tentang kematian dan pentingnya hidup dengan tenang agar arwah tidak tersesat."
hp = 3
attack = 1

