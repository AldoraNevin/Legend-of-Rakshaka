script = ExtResource("card_1")
entity_id = "warak_ngendhog"
region = "Semarang, Jawa Tengah"
category = "Melee"
description = "Makhluk bersisik buraq, berkepala naga, dan berkaki kambing. Berperan sebagai musuh darat yang gesit, menggunakan mekanik Charge dengan tanduknya."
history = "Warak Ngendhog adalah makhluk mitologi ikonik yang selalu muncul dalam tradisi Dugderan (menyambut bulan Ramadan di Semarang). Wujudnya merupakan simbol akulturasi tiga etnis besar di Semarang: kepala naga (Tionghoa), badan buraq/unta (Arab), dan kaki kambing (Jawa). Kata ngendhog (bertelur) melambangkan harapan akan berkah dan rezeki. Kehadirannya mengajarkan harmoni dan toleransi antarbudaya."
hp = 6
attack = 2

