entity_id = "sarpakenaka"
region = "Pewayangan Jawa"
category = "Melee"
description = "Siluman wanita mematikan dengan kuku-kuku panjang beracun. Memiliki gaya serangan rentetan cakaran beruntun yang dapat memberikan status efek debuff pada player."
history = "Sarpakenaka adalah adik perempuan dari Rahwana, Raja Alengka. Ia merupakan raksasa wanita (raksasi) yang memiliki kesaktian untuk berubah wujud menjadi wanita cantik demi memikat Rama dan Laksmana. Ciri khasnya yang mematikan adalah kuku-kuku panjangnya yang beracun (dalam pewayangan Jawa disebut Kuku Pancanaka versi raksasa atau kuku bisa). Amarahnya setelah ditolak Rama menjadi salah satu pemicu awal pecahnya perang besar Ramayana."
hp = 6
attack = 2

