script = ExtResource("card_1")
entity_id = "kuntilanak"
region = "Nusantara (Jawa/Melayu)"
category = "Melee"
description = "Roh wanita pendendam bergaun putih yang melayang di udara. Bergerak mendekati pemain dan melakukan serangan jarak dekat dengan cara memuntahkan darah kental ke arah Player."
history = "Dalam cerita rakyat, Kuntilanak dipercaya sebagai arwah perempuan yang meninggal dunia saat mengandung atau melahirkan, sehingga menyimpan duka dan dendam yang belum selesai. Namanya sering dikaitkan dengan kata \"bunting anak\". Ia identik dengan gaun putih panjang, rambut terurai, suara tawa melengking, serta aroma bunga kamboja atau melati. Secara kultural, mitos ini dulunya menjadi pengingat sosial agar masyarakat lebih menjaga keselamatan ibu hamil."
hp = 3
attack = 1

