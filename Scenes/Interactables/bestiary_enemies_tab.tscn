entity_id = "gupala"
region = "Jawa (Candi)"
category = "Melee"
description = "Arca batu raksasa penjaga candi yang dihidupkan sihir kuno. Musuh tipe idle. Mengayunkan senjata Gada besar yang bisa di picu apabila player berada didekatnya."
history = "Gupala (atau Dwarapala, yang berarti \"penjaga gerbang\") adalah arca batu raksasa yang diletakkan di pintu masuk candi, keraton, atau tempat suci—seperti yang bisa ditemui di Candi Sewu atau Singosari. Wujudnya berupa raksasa bertubuh tambun, bermata melotot, dengan posisi setengah berlutut sambil menggenggam senjata Gada. Secara filosofis, Gupala melambangkan penjaga kesucian tempat ibadah yang menghalau energi negatif masuk."
hp = 8
attack = 3

