entity_id = "aul"
region = "Jawa Barat"
category = "Melee"
description = "Manusia serigala Nusantara dengan wajah terbalik. Merupakan predator darat yang menyerang secara brutal. Memiliki Movement Speed tinggi dan suka melompat untuk menggigit pemain."
history = "Aul adalah makhluk mitologi tanah Sunda yang digambarkan bertubuh seperti serigala atau manusia berbulu dengan ciri khas sangat unik: kepala atau wajahnya terbalik (menghadap ke belakang). Ia dikenal sebagai predator malam yang gesit di pegunungan dan sering memangsa ternak warga seperti kambing. Kecepatan dan wujudnya yang ganjil membuat Aul menjadi salah satu kisah pengingat agar warga tidak berkeliaran sendirian di hutan pegunungan saat malam."
hp = 5
attack = 2

