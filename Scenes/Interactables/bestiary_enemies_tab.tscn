script = ExtResource("card_1")
entity_id = "leak"
region = "Bali"
category = "Ranged"
description = "Leak menjaga jarak dan menyerang dengan proyektil sihir gelap."
history = "Berbeda dari hantu biasa, Leak sebenarnya adalah manusia yang mempelajari ilmu hitam tingkat tinggi (pengiwa) untuk tujuan merugikan orang lain atau mencari keabadian. Pada malam hari, praktisi ilmu Leak konon dapat melepaskan kepala beserta organ dalamnya dari tubuh untuk terbang mencari mangsa atau energi kehidupan. Dalam tradisi Bali, Leak berada di bawah pengaruh Rangda, simbol energi negatif yang selalu berhadapan dengan Barong (simbol kebaikan)."
attack_pattern = "Menjaga jarak dari pemain sambil menembakkan proyektil sihir gelap berkecepatan tinggi."
tactics = "Hindari lintasan proyektil dan cari kesempatan mendekat di antara serangannya."
hp = 4
attack = 1

