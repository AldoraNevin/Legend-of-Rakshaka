script = ExtResource("card_1")
entity_id = "banaspati"
region = "Jawa"
category = "Melee"
description = "Entitas roh purba berwujud bola api atau pusaran tengkorak berapi yang melayang. Berperilaku sangat agresif mengejar pemain dan memberikan efek Burn saat bersentuhan."
history = "Banaspati (secara harfiah sering dikaitkan dengan \"penguasa hutan\" dari bahasa Sanskerta Vanaspati) dalam folklor Jawa dikenal sebagai makhluk halus berelemen api. Wujudnya digambarkan seperti bola api melayang atau pusaran api yang kadang menampakkan wajah tengkorak. Di masa lalu, masyarakat percaya Banaspati muncul di hutan lebat atau area angker pada malam hari dan mampu membakar siapa saja yang nekat melintas tanpa permisi."
hp = 4
attack = 1

