script = ExtResource("card_1")
entity_id = "genderuwo"
region = "Jawa"
category = "Melee"
description = "Makhluk halus raksasa berbulu lebat. Memiliki Health Point (HP) yang sangat tebal. Menyerang dengan pukulan keras ke tanah yang menghasilkan getaran Area of Effect (AoE) di sekitarnya."
history = "Kata Genderuwo berasal dari bahasa Sanskerta Gandharva (makhluk surgawi pemusik dalam mitologi Hindu-Buddha), namun dalam folklor Jawa mengalami pergeseran makna menjadi makhluk halus bertubuh raksasa, kekar, dan berbulu lebat. Ia dipercaya menghuni pohon-pohon besar (seperti beringin), batu besar, atau bangunan tua yang lembap dan gelap. Mitos ini sering digunakan masyarakat tradisional untuk menjaga kelestarian pohon tua agar tidak sembarangan ditebang."
hp = 10
attack = 2

