toggle_mode = true
script = ExtResource("card_1")
entity_id = "mahesa_sura"
region = "Jawa"
category = "Melee"
description = "Siluman beringas berbadan manusia dengan kepala kerbau. Musuh brutal yang menggunakan serangan Dash merusak rintangan dan menghasilkan damage fisik yang masif."
history = "Mahesa Sura adalah tokoh legendaris berbadan manusia dan berkepala kerbau (Mahesa = kerbau, Sura = berani/sakti). Dalam legenda Gunung Kelud, ia jatuh cinta pada Dewi Kilisuci dari Kerajaan Jenggala. Karena enggan menikah dengannya, Dewi Kilisuci memberi syarat mustahil: membuat sumur di puncak Gunung Kelud dalam semalam. Saat Mahesa Sura berhasil dan masih berada di dalam sumur, ia ditimbun batu hingga tewas. Sumpah serapahnya sebelum mati dipercaya menjadi penyebab letusan Gunung Kelud."
hp = 7
attack = 3

