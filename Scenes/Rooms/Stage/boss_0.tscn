[sub_resource type="Shader" id="WetStoneShader"]
code = "shader_type canvas_item;
void fragment() {
    vec4 stone = texture(TEXTURE, UV);
    float light = dot(stone.rgb, vec3(0.299, 0.587, 0.114));
    vec3 marine = mix(vec3(0.025, 0.095, 0.12), vec3(0.43, 0.84, 0.75), light);
    COLOR = vec4(mix(stone.rgb, marine, 0.67), stone.a);
}"

