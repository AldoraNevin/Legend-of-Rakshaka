[node name="DialoguePages" type="Node" parent="."]

[node name="Introduction" type="Node" parent="DialoguePages"]

[node name="Greeting" type="Node" parent="DialoguePages/Introduction"]
script = ExtResource("dialogue_line")
text = "Selamat datang, Rakshaka! Aku Semar. Mari berlatih sebelum melanjutkan perjalanan."

[node name="Movement" type="Node" parent="DialoguePages/Introduction"]
script = ExtResource("dialogue_line")
text = "Gunakan {ui_left} dan {ui_right} untuk bergerak. Tekan {ui_accept} untuk melompat; tekan lagi di udara untuk lompatan kedua."

[node name="Combat" type="Node" parent="DialoguePages/Introduction"]
script = ExtResource("dialogue_line")
text = "Tekan {ui_sword} untuk menyerang dengan pedang. Tekan {ui_dash} untuk dash dan menghindari serangan."

[node name="Practice" type="Node" parent="DialoguePages/Introduction"]
script = ExtResource("dialogue_line")
text = "Sekarang kalahkan Aul latihan. Setelah menang, kembali dan bicara denganku untuk melapor sebelum masuk gate."

[node name="Report" type="Node" parent="DialoguePages"]
script = ExtResource("dialogue_line")
text = "Bagus, Rakshaka! Kamu sudah mengalahkan Aul dan menyelesaikan latihan. Gate telah siap. Lanjutkan perjalananmu ke Room 1!"

